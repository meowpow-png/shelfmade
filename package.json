{
  "name": "shelfmade",
  "version": "0.2.1",
  "description": "A CLI for turning MDX content and reusable components into print-ready books.",
  "license": "MIT",
  "author": {
    "name": "Marin Softić",
    "url": "https://www.meowpow.dev"
  },
  "keywords": [
    "book",
    "ebook",
    "print",
    "pdf",
    "mdx",
    "react",
    "pagination",
    "ai"
  ],
  "homepage": "https://github.com/meowpow-png/shelfmade#readme",
  "bugs": "https://github.com/meowpow-png/shelfmade/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meowpow-png/shelfmade.git"
  },
  "bin": {
    "shelfmade": "bin/shelfmade.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "bin",
    "dist",
    "src/assets",
    "src/client",
    "src/engine/page-format.ts",
    "src/runtime",
    "template"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "prepare": "lefthook install",
    "clean": "rm -rf node_modules dist",
    "build": "tsc && tsc-alias && cp -r src/runtime dist/ && cp -r src/assets dist/",
    "watch:runtime": "chokidar \"src/runtime/**\" \"src/assets/**\" -c \"scripts/copy-runtime-asset.sh {path}\"",
    "prepack": "rm -rf dist && npm run build",
    "test": "playwright test",
    "example:install": "npm install --prefix examples/sample-book --no-audit --no-fund --ignore-scripts --silent",
    "example:build": "npm run build && node bin/shelfmade.mjs build --root examples/sample-book",
    "dev:example": "node bin/shelfmade.mjs dev --root examples/sample-book",
    "example": "npm run example:install && npm run build && run-p watch:runtime dev:example",
    "example:pdf": "npm run build && node bin/shelfmade.mjs pdf --root examples/sample-book",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"**/*.css\" --allow-empty-input",
    "lint": "run-s --continue-on-error lint:eslint lint:stylelint",
    "lint:fix:eslint": "eslint . --fix",
    "lint:fix:stylelint": "stylelint \"**/*.css\" --allow-empty-input --fix",
    "lint:fix": "run-s --continue-on-error lint:fix:eslint lint:fix:stylelint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client && tsc --noEmit -p tests",
    "knip": "knip",
    "qualitycheck": "run-s --continue-on-error format:check lint typecheck build knip"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@types/mdx": "^2.0.14",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "pagedjs": "0.4.3",
    "playwright": "^1.65.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tsc-alias": "^1.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
